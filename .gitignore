# Python virtual environments
.venv/
venv/
env/

# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter-generated files
.ipynb_checkpoints/

# Ignore the entire local data directory, including datasets and processed CSVs
/data/

# Ignore trained model files but keep the models folder in Git
/models/*
!/models/.gitkeep

# Local environment and editor files
.env
.env.*
!.env.example
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
